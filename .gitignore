# 운영체제 생성 파일
.DS_Store
Thumbs.db

# 환경 변수와 로컬 자격 증명
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example

# Python 실행 캐시와 격리 환경
__pycache__/
*.py[cod]
.venv/
.venv-ocr/
.uv-cache/

# Node 패키지와 테스트 결과
node_modules/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cloudflare Wrangler/D1 로컬 상태와 생성물
.wrangler/
.d1/

# 수집 원본과 재생성 가능한 대용량 데이터
raw/
cache/
extracted/
normalized/

# 로컬 로그와 임시 파일
*.log
*.tmp
*.swp
